#!/system/bin/sh
# ==============================================================================
# alpine - Dedicated launcher shortcut for Alpine Linux chroot
# Usage: alpine [command...]
# ==============================================================================

# Resolve real script directory across symlinks
_SELF="$0"
while [ -L "$_SELF" ]; do
    _TARGET="$(readlink "$_SELF")"
    case "$_TARGET" in
        /*) _SELF="$_TARGET" ;;
        *) _SELF="$(dirname "$_SELF")/$_TARGET" ;;
    esac
done

SCRIPT_DIR="$(cd "$(dirname "$_SELF")" 2>/dev/null && pwd)"
[ ! -f "$SCRIPT_DIR/chroot-run" ] && SCRIPT_DIR="/data/chroot/bin"

exec "$SCRIPT_DIR/chroot-run" alpine "$@"
