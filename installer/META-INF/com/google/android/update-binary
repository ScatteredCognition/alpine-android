#!/sbin/sh
# ==============================================================================
# TWRP / OrangeFox Recovery Flashable Installer for Alpine Linux Chroot
# Branch: edge (Rolling / Unstable)
# ==============================================================================

OUTFD=$2
ZIPFILE=$3

ui_print() {
    if [ -n "$OUTFD" ]; then
        echo "ui_print $1" >&$OUTFD
        echo "ui_print" >&$OUTFD
    else
        echo "$1"
    fi
}

ui_print "*****************************************"
ui_print "    Alpine Linux (edge) Installer        "
ui_print "    for Android (ARM64)                  "
ui_print "*****************************************"

# 1. Mount /data
ui_print "- Mounting /data..."
mount /data 2>/dev/null || true
if ! mountpoint -q /data && ! mountpoint -q /sdcard; then
    ui_print "[!] Error: /data is not mounted or encrypted!"
    exit 1
fi

CHROOT_DIR="/data/chroot/alpine"
INSTALL_BASE="/data/chroot"

# 2. Extract rootfs from zip
ui_print "- Extracting Alpine edge rootfs to $CHROOT_DIR..."

if [ -d "$CHROOT_DIR" ]; then
    ui_print "- Cleaning existing chroot directory..."
    umount -f "$CHROOT_DIR/sdcard" 2>/dev/null || true
    umount -f "$CHROOT_DIR/dev/shm" 2>/dev/null || true
    umount -f "$CHROOT_DIR/dev/pts" 2>/dev/null || true
    umount -f "$CHROOT_DIR/dev" 2>/dev/null || true
    umount -f "$CHROOT_DIR/proc" 2>/dev/null || true
    umount -f "$CHROOT_DIR/sys" 2>/dev/null || true
    rm -rf "$CHROOT_DIR"
fi
mkdir -p "$CHROOT_DIR"

TAR_CMD="tar"
if command -v busybox >/dev/null 2>&1 && busybox tar --help >/dev/null 2>&1; then
    TAR_CMD="busybox tar"
fi

if command -v unzip >/dev/null 2>&1; then
    (cd "$CHROOT_DIR" && unzip -p "$ZIPFILE" "rootfs.tar.gz" | $TAR_CMD -xz) || {
        ui_print "[!] Failed extracting rootfs.tar.gz from zip"; exit 1;
    }
else
    ui_print "[!] Error: unzip command missing in recovery environment"; exit 1;
fi

# 3. Extract modular helpers (bin/), configs (distros/), and utilities (utils/)
ui_print "- Installing modular helpers and distribution configurations..."
mkdir -p "$INSTALL_BASE/bin" "$INSTALL_BASE/distros" "$INSTALL_BASE/utils"

if unzip -l "$ZIPFILE" | grep -q "bin/chroot-helper"; then
    unzip -o "$ZIPFILE" "bin/*" "distros/*" -d "$INSTALL_BASE" 2>/dev/null || true
    chmod 755 "$INSTALL_BASE/bin/"* 2>/dev/null || true
    chmod 644 "$INSTALL_BASE/distros/"* 2>/dev/null || true
fi

if unzip -l "$ZIPFILE" | grep -q "utils/curl"; then
    unzip -oj "$ZIPFILE" "utils/curl" "utils/busybox" -d "$INSTALL_BASE/utils" 2>/dev/null || true
    chmod 755 "$INSTALL_BASE/utils/"* 2>/dev/null || true
fi

# 4. Setup DNS
ui_print "- Setting up DNS configuration..."
cat << 'EOF' > "$CHROOT_DIR/etc/resolv.conf"
nameserver 1.1.1.1
nameserver 8.8.8.8
EOF

# 5. Configure edge repositories (main + community)
ui_print "- Configuring edge package repositories..."
cat << 'EOF' > "$CHROOT_DIR/etc/apk/repositories"
https://dl-cdn.alpinelinux.org/alpine/edge/main
https://dl-cdn.alpinelinux.org/alpine/edge/community
EOF

# 6. Inject Android AID network groups
ui_print "- Configuring Android network AID GIDs..."
grep -q "^aid_inet:" "$CHROOT_DIR/etc/group" 2>/dev/null || echo "aid_inet:x:3003:root" >> "$CHROOT_DIR/etc/group"
grep -q "^aid_net_raw:" "$CHROOT_DIR/etc/group" 2>/dev/null || echo "aid_net_raw:x:3004:root" >> "$CHROOT_DIR/etc/group"
grep -q "^aid_admin:" "$CHROOT_DIR/etc/group" 2>/dev/null || echo "aid_admin:x:3005:root" >> "$CHROOT_DIR/etc/group"

# 7. Create mount target folders
mkdir -p "$CHROOT_DIR/dev" "$CHROOT_DIR/dev/pts" "$CHROOT_DIR/dev/shm" "$CHROOT_DIR/proc" "$CHROOT_DIR/sys" "$CHROOT_DIR/sdcard"

# 8. Clean up any obsolete root scripts
rm -f "$INSTALL_BASE/enter-alpine.sh" "$INSTALL_BASE/stop-alpine.sh" "$INSTALL_BASE/alpine" 2>/dev/null || true

# 9. Optional: Register KernelSU/Magisk module if modules directory exists
if [ -d /data/adb/modules ]; then
    ui_print "- Registering KernelSU/Magisk overlay module (id: chroot)..."
    # Clean up obsolete alpine module if present
    rm -rf /data/adb/modules/alpine 2>/dev/null || true

    MOD_DIR="/data/adb/modules/chroot"
    mkdir -p "$MOD_DIR/system/bin"
    
    cat << 'EOF' > "$MOD_DIR/module.prop"
id=chroot
name=Multi-Distro Linux Chroot for Android
version=rolling-edge
versionCode=3
author=Faeiz Mahrus (built with Antigravity)
description=Universal /system/bin command suite (alpine, chroot-run, chroot-stop, chroot-status, chroot-install) for native Android chroots.
EOF
    
    ln -sf "$INSTALL_BASE/bin/alpine" "$MOD_DIR/system/bin/alpine"
    ln -sf "$INSTALL_BASE/bin/chroot-run" "$MOD_DIR/system/bin/chroot-run"
    ln -sf "$INSTALL_BASE/bin/chroot-stop" "$MOD_DIR/system/bin/chroot-stop"
    ln -sf "$INSTALL_BASE/bin/chroot-status" "$MOD_DIR/system/bin/chroot-status"
    ln -sf "$INSTALL_BASE/bin/chroot-install" "$MOD_DIR/system/bin/chroot-install"
    
    chmod -R 755 "$MOD_DIR"
    chcon -h u:object_r:system_file:s0 "$MOD_DIR/system/bin/"* 2>/dev/null || true
    ui_print "  -> Overlaid commands into /system/bin/"
fi

ui_print "*****************************************"
ui_print "  Installation Complete!                 "
ui_print "  Run: /data/chroot/bin/alpine           "
ui_print "  (or 'alpine' if overlaid into PATH)    "
ui_print "*****************************************"
exit 0
